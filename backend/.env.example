# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Prisma MongoDB Client URI)
# Replace credentials and clusters with your MongoDB deployment parameters
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexacore?retryWrites=true&w=majority"

# Better Auth Parameters
# Generate a secure secret using: openssl rand -hex 32
BETTER_AUTH_SECRET="your_better_auth_secret_here"
BETTER_AUTH_URL="http://localhost:5000"

# CORS Frontend Origin
FRONTEND_URL="http://localhost:3000"
