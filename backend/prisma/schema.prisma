datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  HR
  PROJECT_MANAGER
  EMPLOYEE
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  role          Role      @default(EMPLOYEE)
  phone         String?
  department    String?
  designation   String?
  bio           String?
  location      String?
  emergencyContact String?
  documentsUrl  String?
  twoFactorEnabled Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // Project Relations
  managedProjects Project[] @relation("ProjectManager")
  projectIds      String[]  @db.ObjectId
  projects        Project[] @relation("ProjectEmployees", fields: [projectIds], references: [id])

  // Message and Task Relations
  messages        Message[]
  assignedTasks   Task[]

  // Announcement Relations
  announcements   Announcement[] @relation("AnnouncementAuthor")

  // Attendance Relations
  attendance      Attendance[]

  // Leave Request Relations
  leaveRequests         LeaveRequest[] @relation("LeaveRequestUser")
  approvedLeaveRequests LeaveRequest[] @relation("LeaveRequestApprover")

  // Payroll Relations
  payrolls              Payroll[] @relation("PayrollUser")

  // Loan Relations
  loans                 Loan[] @relation("LoanUser")

  // Performance Evaluation Relations
  evaluationsReceived   Evaluation[] @relation("EvaluationUser")
  evaluationsCreated    Evaluation[] @relation("EvaluationPM")

  // Notification Relations
  notifications         Notification[] @relation("UserNotifications")

  // Grievance Relations
  grievances            Grievance[] @relation("GrievanceUser")

  // Calendar Event Relations
  calendarEvents        CalendarEvent[] @relation("UserCalendarEvents")

  // Meeting Room Booking Relations
  roomBookings          RoomBooking[] @relation("UserRoomBookings")

  // Poll Relations
  pollsCreated          Poll[] @relation("PollAuthor")
  pollVotes             PollVote[] @relation("UserPollVotes")

  // Certificate Relations
  certificatesReceived  Certificate[] @relation("RecipientCertificates")
  certificatesIssued    Certificate[] @relation("IssuedCertificates")

  // Finance Relations
  financeExpenses       FinanceExpense[] @relation("UserFinanceExpenses")

  // Knowledge Base Relations
  knowledgeDocuments    KnowledgeDocument[] @relation("KnowledgeAuthor")

  @@map("user")
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String
  providerId            String
  userId                String    @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Project {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  status         String    @default("ACTIVE") // PENDING, ACTIVE, PENDING_SETTLEMENT, COMPLETED
  budget         Float     @default(0.0)
  payoutApproved Boolean   @default(false)
  payoutBonus    Float     @default(0.0)
  client         String?
  startDate      DateTime?
  endDate        DateTime?
  priority       String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  category       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Manager relation (PM / HR)
  managerId   String    @db.ObjectId
  manager     User      @relation("ProjectManager", fields: [managerId], references: [id])

  // Employee relations
  employeeIds String[]  @db.ObjectId
  employees   User[]    @relation("ProjectEmployees", fields: [employeeIds], references: [id])

  // Channel & Task & Poll & Certificate child relations
  channels     Channel[]
  tasks        Task[]
  polls        Poll[]
  certificates Certificate[]

  @@map("project")
}

model Channel {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Parent Project relation
  projectId String    @db.ObjectId
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Message relation
  messages  Message[]

  @@map("channel")
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sender relation
  senderId  String   @db.ObjectId
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Channel relation
  channelId String   @db.ObjectId
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("message")
}

model Task {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  column      String    @default("TODO") // TODO, IN_PROGRESS, TESTING, COMPLETED
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Parent Project relation
  projectId   String    @db.ObjectId
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Assignee relation
  assigneeId  String?   @db.ObjectId
  assignee    User?     @relation(fields: [assigneeId], references: [id])

  @@map("task")
}

model Announcement {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Author relation
  authorId  String   @db.ObjectId
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("announcement")
}

model KnowledgeDocument {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  category    String   @default("POLICY") // POLICY, CODING_GUIDELINES, PROJECT_DOCS, ONBOARDING
  fileUrl     String   // Google Drive URL or direct PDF/doc link
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Author relation
  authorId    String   @db.ObjectId
  author      User     @relation("KnowledgeAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("knowledge_document")
}

model Attendance {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String    // e.g. "2026-08-12"
  clockIn      DateTime
  clockOut     DateTime?
  hoursWorked  Float     @default(0.0)
  isLate       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, date])
  @@map("attendance")
}

enum LeaveType {
  LEAVE
  WFH
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      LeaveStatus @default(PENDING)
  comment     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  userId      String      @db.ObjectId
  user        User        @relation("LeaveRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  
  approverId  String?     @db.ObjectId
  approver    User?       @relation("LeaveRequestApprover", fields: [approverId], references: [id])

  @@map("leave_request")
}

model Payroll {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  user          User      @relation("PayrollUser", fields: [userId], references: [id], onDelete: Cascade)
  month         String    // e.g. "2026-08"
  baseSalary    Float
  bonus         Float     @default(0.0)
  deductions    Float     @default(0.0)
  netSalary     Float
  status        String    @default("PENDING") // PENDING, PAID
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, month])
  @@map("payroll")
}

model Loan {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  amount           Float
  installments     Int
  installmentsPaid Int      @default(0)
  monthlyRepayment Float
  reason           String
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED, ACTIVE, REPAID
  comment          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  userId           String   @db.ObjectId
  user             User     @relation("LoanUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("loan")
}

model Evaluation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Int      // 1 to 5
  feedback  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId    String   @db.ObjectId
  user      User     @relation("EvaluationUser", fields: [userId], references: [id], onDelete: Cascade)

  pmId      String   @db.ObjectId
  pm        User     @relation("EvaluationPM", fields: [pmId], references: [id], onDelete: Cascade)

  @@map("evaluation")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  type      String   // "ATTENDANCE" | "ANNOUNCEMENT" | "LEAVE" | "PROJECT" | "PAYROLL" | "LOAN" | "EVALUATION" | "GENERAL"
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId    String   @db.ObjectId
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification")
}

enum GrievanceStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
  DISMISSED
}

enum GrievanceCategory {
  HARASSMENT
  WORKPLACE_SAFETY
  COMPENSATION
  MANAGER_CONFLICT
  DISCRIMINATION
  ETHICS_VIOLATION
  OTHER
}

enum GrievanceUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Grievance {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  userId         String            @db.ObjectId
  user           User              @relation("GrievanceUser", fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String
  category       GrievanceCategory @default(OTHER)
  urgency        GrievanceUrgency  @default(MEDIUM)
  isAnonymous    Boolean           @default(false)
  status         GrievanceStatus   @default(OPEN)
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("grievance")
}

enum CalendarEventType {
  HOLIDAY
  COMPANY_EVENT
  MEETING
  PROJECT_DEADLINE
  TASK_DUE
  LEAVE
  WFH
}

model CalendarEvent {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  type        CalendarEventType @default(COMPANY_EVENT)
  startDate   DateTime
  endDate     DateTime
  isGlobal    Boolean           @default(false)
  
  // Optional user relation for personalized / scheduled meetings
  userId      String?           @db.ObjectId
  user        User?             @relation("UserCalendarEvents", fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("calendar_event")
}

enum RoomStatus {
  AVAILABLE
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model MeetingRoom {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  floor       String
  capacity    Int           @default(8)
  amenities   String[]
  status      RoomStatus    @default(AVAILABLE)
  bookings    RoomBooking[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("meeting_room")
}

model RoomBooking {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  roomId      String        @db.ObjectId
  room        MeetingRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String        @db.ObjectId
  user        User          @relation("UserRoomBookings", fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  date        String        // YYYY-MM-DD
  startTime   String        // "10:00"
  endTime     String        // "11:30"
  attendees   Int           @default(2)
  status      BookingStatus @default(PENDING)
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("room_booking")
}

enum PollTarget {
  COMPANY_WIDE
  PROJECT
}

enum PollStatus {
  ACTIVE
  CLOSED
}

model Poll {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String?
  target        PollTarget   @default(COMPANY_WIDE)
  status        PollStatus   @default(ACTIVE)
  
  // Optional project association
  projectId     String?      @db.ObjectId
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Options
  options       PollOption[]
  
  // Multi-choice & Expiry
  allowMultiple Boolean      @default(false)
  expiresAt     DateTime?
  
  // Author
  authorId      String       @db.ObjectId
  author        User         @relation("PollAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  
  // Votes
  votes         PollVote[]
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("poll")
}

model PollOption {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  pollId    String     @db.ObjectId
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text      String
  votes     PollVote[]

  @@map("poll_option")
}

model PollVote {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  pollId    String     @db.ObjectId
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String     @db.ObjectId
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String     @db.ObjectId
  user      User       @relation("UserPollVotes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([pollId, userId, optionId])
  @@map("poll_vote")
}

enum CertificateType {
  PROJECT_COMPLETION
  TRAINING_WORKSHOP
  EXCELLENCE_AWARD
  SKILL_ACHIEVEMENT
}

model Certificate {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  certificateCode String          @unique
  title           String
  type            CertificateType @default(PROJECT_COMPLETION)
  description     String?
  
  // Recipient
  recipientId     String          @db.ObjectId
  recipient       User            @relation("RecipientCertificates", fields: [recipientId], references: [id], onDelete: Cascade)
  
  // Optional project association
  projectId       String?         @db.ObjectId
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  // Issuer
  issuerId        String          @db.ObjectId
  issuer          User            @relation("IssuedCertificates", fields: [issuerId], references: [id], onDelete: Cascade)
  issuedAt        DateTime        @default(now())
  
  // Signatory stamps
  pmSignature     String?
  hrSignature     String?
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("certificate")
}

enum ExpenseCategory {
  CLOUD_INFRASTRUCTURE
  SAAS_SUBSCRIPTIONS
  HARDWARE_EQUIPMENT
  OFFICE_OPERATIONS
  TEAM_EVENTS
  LEGAL_COMPLIANCE
  MARKETING_ADVERTISING
  OTHER
}

enum ExpenseStatus {
  APPROVED
  PENDING
  REIMBURSED
}

model FinanceExpense {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  amount       Float
  category     ExpenseCategory @default(CLOUD_INFRASTRUCTURE)
  vendor       String?
  invoiceRef   String?
  status       ExpenseStatus   @default(APPROVED)
  date         String          // YYYY-MM-DD
  notes        String?
  
  // Recorded by
  recordedById String          @db.ObjectId
  recordedBy   User            @relation("UserFinanceExpenses", fields: [recordedById], references: [id], onDelete: Cascade)
  
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("finance_expense")
}

model FinanceBudget {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  fiscalYear  Int      @default(2026)
  quarter     String   @default("Q3") // Q1, Q2, Q3, Q4
  allocated   Float    @default(250000.0)
  reserveFund Float    @default(50000.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("finance_budget")
}






