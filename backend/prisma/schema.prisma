datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  HR
  PROJECT_MANAGER
  EMPLOYEE
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  password      String?
  role          Role      @default(EMPLOYEE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // Project Relations
  managedProjects Project[] @relation("ProjectManager")
  projectIds      String[]  @db.ObjectId
  projects        Project[] @relation("ProjectEmployees", fields: [projectIds], references: [id])

  // Message and Task Relations
  messages        Message[]
  assignedTasks   Task[]

  // Announcement Relations
  announcements   Announcement[] @relation("AnnouncementAuthor")

  // Attendance Relations
  attendance      Attendance[]

  @@map("user")
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String
  providerId            String
  userId                String    @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Project {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED
  budget      Float     @default(0.0)
  client      String?
  startDate   DateTime?
  endDate     DateTime?
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  category    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Manager relation (PM / HR)
  managerId   String    @db.ObjectId
  manager     User      @relation("ProjectManager", fields: [managerId], references: [id])

  // Employee relations
  employeeIds String[]  @db.ObjectId
  employees   User[]    @relation("ProjectEmployees", fields: [employeeIds], references: [id])

  // Channel & Task child relations
  channels    Channel[]
  tasks       Task[]

  @@map("project")
}

model Channel {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Parent Project relation
  projectId String    @db.ObjectId
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Message relation
  messages  Message[]

  @@map("channel")
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sender relation
  senderId  String   @db.ObjectId
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Channel relation
  channelId String   @db.ObjectId
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("message")
}

model Task {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  column      String    @default("TODO") // TODO, IN_PROGRESS, TESTING, COMPLETED
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Parent Project relation
  projectId   String    @db.ObjectId
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Assignee relation
  assigneeId  String?   @db.ObjectId
  assignee    User?     @relation(fields: [assigneeId], references: [id])

  @@map("task")
}

model Announcement {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Author relation
  authorId  String   @db.ObjectId
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@map("announcement")
}

model Attendance {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String    // e.g. "2026-08-12"
  clockIn      DateTime
  clockOut     DateTime?
  hoursWorked  Float     @default(0.0)
  isLate       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, date])
  @@map("attendance")
}
